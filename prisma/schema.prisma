generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  username        String       @unique
  displayName     String
  avatarUrl       String?
  email           String?      @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  isDemo          Boolean      @default(false)
  accountStatus   String       @default("active")
  createdAt       DateTime     @default(now())
  profile         UserProfile?
  posts           Post[]
  projects        Project[]

  followingEdges Follow[] @relation("FollowOut")
  followerEdges  Follow[] @relation("FollowIn")

  comments       Comment[]
  postLikes      PostLike[]
  postSaves      PostSave[]
  wishlistItems  WishlistItem[]
  demoOrders     DemoOrder[]
  lessonProgress UserLessonProgress[]

  authTokens    AuthToken[]
  sessions      Session[]
  sentMessages  Message[]                  @relation("MessageSender")
  conversations ConversationParticipant[]
}

model UserProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                 String
  budgetTier           Int       @default(0)
  intro                String    @default("")
  direction            String    @default("")
  skillKeywords        String    @default("[]")
  interestTags         String    @default("[]")
  desiredPartnerRoles  String    @default("[]")
  remoteOk             Boolean   @default(false)
  githubUrl            String    @default("")
  verifiedAt           DateTime?
  updatedAt            DateTime  @updatedAt
}

model Post {
  id              String   @id @default(cuid())
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type            String
  title           String
  excerpt         String   @default("")
  coverUrl        String
  body            String   @default("")
  status          String   @default("published")
  meta            String   @default("{}")
  linkedProjectId String?
  linkedToolId    String?
  linkedModelId   String?
  linkedModel     AiModel? @relation(fields: [linkedModelId], references: [id], onDelete: SetNull)
  likes           Int      @default(0)
  saves           Int      @default(0)
  tags            String   @default("[]")
  createdAt       DateTime @default(now())

  comments Comment[]
  likedBy  PostLike[]
  savedBy  PostSave[]

  @@index([status, createdAt])
  @@index([type])
  @@index([linkedModelId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("FollowOut", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowIn", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostLike {
  userId String
  postId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostSave {
  userId String
  postId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  coverUrl    String   @default("")
  repoUrl     String   @default("")
  previewUrl  String   @default("")
  stack       String   @default("[]")
  teamNeeds   String   @default("")
  stage       String   @default("")
  tags        String   @default("[]")
  revenueBand String   @default("")
  createdAt   DateTime @default(now())
}

model Template {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  category    String
  stack       String   @default("[]")
  downloadUrl String   @default("")
  copyCmd     String   @default("")
  createdAt   DateTime @default(now())
}

model Tool {
  id          String       @id @default(cuid())
  name        String
  category    String
  description String       @default("")
  avgRating   Float        @default(0)
  reviews     ToolReview[]
}

model ToolReview {
  id          String   @id @default(cuid())
  toolId      String
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId      String?
  userName    String
  rating      Int
  comment     String   @default("")
  authorReply String   @default("")
  createdAt   DateTime @default(now())
}

model AiModel {
  id          String          @id @default(cuid())
  name        String
  provider    String
  description String          @default("")
  logoUrl     String          @default("")
  websiteUrl  String          @default("")
  strengths   String          @default("[]")
  scenarios   String          @default("[]")
  avgRating   Float           @default(0)
  reviewCount Int             @default(0)
  rankScore   Float           @default(0)
  createdAt   DateTime        @default(now())
  reviews     AiModelReview[]
  posts       Post[]

  @@index([rankScore])
  @@index([avgRating])
}

model AiModelReview {
  id        String   @id @default(cuid())
  modelId   String
  model     AiModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String
  rating    Int
  pros      String   @default("")
  cons      String   @default("")
  scenario  String   @default("")
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([modelId, createdAt])
}

model MarketItem {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  priceCents  Int      @default(0)
  itemType    String
  createdAt   DateTime @default(now())

  wishlistItems WishlistItem[]
  demoOrders    DemoOrder[]
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  createdAt DateTime @default(now())
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  market MarketItem @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
}

model DemoOrder {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  status    String   @default("DEMO_PAID")
  createdAt DateTime @default(now())
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  market MarketItem @relation(fields: [marketId], references: [id], onDelete: Cascade)
}

model UserLessonProgress {
  userId    String
  step      Int
  done      Boolean  @default(true)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, step])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  meta           String       @default("{}")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
